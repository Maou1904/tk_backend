# tk_backend/.gitignore

# Dependencies
node_modules/

# Environment variables (สำคัญมาก!)
.env
.env.test
.env.local

# Local Uploads (ถ้าเก็บรูปสินค้าไว้ในเครื่อง)
public/uploads/*
!public/uploads/.gitkeep

# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Testing
coverage/
.nyc_output